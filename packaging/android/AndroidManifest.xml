<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@APPLICATION_ID@">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <package android:name="dev.horizon.android" />
    </queries>
    <application
        android:label="Oxide"
        android:icon="@drawable/ic_oxide"
        android:hasCode="true"
        android:isGame="true"
        android:appCategory="game"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">
        <activity
            android:name="io.github.juanluci.starling.LauncherActivity"
            android:exported="true"
            android:process=":launcher"
            android:taskAffinity="@APPLICATION_ID@.launcher"
            android:excludeFromRecents="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.starling" />
                <data android:pathPattern=".*\\..*\\.starling" />
                <data android:pathPattern=".*\\..*\\..*\\.starling" />
                <data android:pathPattern=".*\\.hmod" />
                <data android:pathPattern=".*\\..*\\.hmod" />
                <data android:pathPattern=".*\\..*\\..*\\.hmod" />
                <data android:pathPattern=".*\\.hnmod" />
                <data android:pathPattern=".*\\..*\\.hnmod" />
                <data android:pathPattern=".*\\..*\\..*\\.hnmod" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <activity-alias android:name="io.github.juanluci.starling.StarlingActivity"
            android:targetActivity="io.github.juanluci.starling.LauncherActivity"
            android:exported="true">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name="io.github.juanluci.starling.GameActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:theme="@style/Starling.Game"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|fontWeightAdjustment|grammaticalGender">
            <meta-data android:name="android.app.lib_name" android:value="horizon_android" />
            <meta-data android:name="android.app.func_name" android:value="starling_on_create" />
        </activity>
        <activity android:name="io.github.juanluci.starling.DiagnosticsActivity"
            android:exported="true" android:process=":diagnostics"
            android:theme="@style/Starling.Game" android:hardwareAccelerated="false" />
        <service
            android:name="io.github.juanluci.starling.WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider
            android:name="io.github.juanluci.starling.UpdateProvider"
            android:authorities="@APPLICATION_ID@.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name="io.github.juanluci.starling.GameFolderProvider"
            android:authorities="@APPLICATION_ID@.documents"
            android:exported="true"
            android:process=":documents"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
